style = 'blue bold'
# disabled = false
# read_only = ' ø' # U+00F8 Latin Small Letter O with Stroke
read_only = ' ⊝' # U+229D Circled Dash
# read_only_style = 'red'
truncation_symbol = '*'
# home_symbol = '~'
use_os_path_sep = false
